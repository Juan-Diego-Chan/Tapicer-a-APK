rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Funciones de ayuda (reutilizadas por los planes 2-5) ----
    function autenticado() {
      return request.auth != null;
    }

    function existeUsuario() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function usuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function activo() {
      return existeUsuario() && usuario().activo == true;
    }

    function esDueno() {
      return activo() && usuario().rol == 'dueno';
    }

    function esEmpleado() {
      return activo() && usuario().rol == 'empleado';
    }

    // Solo para update: requiere que el documento exista (usa resource).
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ---- Usuarios ----
    match /usuarios/{uid} {
      // Cada quien lee su propio doc (incluso inactivo, para saber que lo esta).
      allow get: if autenticado() && (request.auth.uid == uid || activo());
      allow list: if activo();
      allow create, delete: if esDueno();
      allow update: if esDueno()
        || (esEmpleado() && request.auth.uid == uid && soloCambia(['nombre'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 100);
    }

    // ---- Solo dueño activo ----
    match /usuarios_privado/{uid} {
      allow read, write: if esDueno();
    }

    match /config/{doc} {
      allow read, write: if esDueno();
    }

    // ---- Inventario ----
    function materialValido(d) {
      return d.keys().hasOnly(['nombre', 'categoria', 'unidad', 'stockMinimo', 'existencia', 'usaRollos', 'marcadoAgotandose'])
        && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 100
        && d.categoria in ['tela', 'espuma', 'guata', 'resortes', 'cinchas', 'grapas', 'otros']
        && d.unidad in ['m', 'kg', 'pza', 'l']
        && d.stockMinimo is number && d.stockMinimo >= 0
        && d.existencia is number
        && d.existencia == d.existencia
        && d.existencia > -1000000000000000 && d.existencia < 1000000000000000
        && d.usaRollos is bool
        && d.marcadoAgotandose is bool;
    }

    function rolloValido(d) {
      return d.keys().hasOnly(['materialId', 'codigo', 'cantidadInicial', 'existencia', 'fechaCompra'])
        && d.materialId is string
        && d.codigo is string && d.codigo.size() >= 1 && d.codigo.size() <= 20
        && d.cantidadInicial is number && d.cantidadInicial > 0
        && d.existencia is number
        && d.fechaCompra is timestamp;
    }

    function movimientoValido(d) {
      return d.keys().hasOnly(['tipo', 'materialId', 'rolloId', 'cantidad', 'pedidoId', 'muebleId', 'usuarioId', 'fecha'])
        && d.tipo in ['compra', 'inicial', 'consumo', 'ajuste']
        && d.materialId is string
        && (d.get('rolloId', null) == null || d.rolloId is string)
        && (d.get('pedidoId', null) == null || d.pedidoId is string)
        && (d.get('muebleId', null) == null || d.muebleId is string)
        && d.cantidad is number
        && d.usuarioId == request.auth.uid
        && d.fecha is timestamp;
    }

    // ---- Consumo de material y días trabajados ----
    // Línea de material usado en un mueble (pedidos/{p}/muebles/{m}/materiales/{l}).
    function lineaValida(d) {
      return d.keys().hasOnly(['materialId', 'rolloId', 'cantidad', 'delCliente', 'usuarioId', 'fecha'])
        && d.materialId is string
        && (d.rolloId == null || d.rolloId is string)
        && d.cantidad is number && d.cantidad > 0 && d.cantidad < 1000000
        && d.delCliente is bool
        && d.usuarioId == request.auth.uid
        && d.fecha is timestamp;
    }

    // Días: múltiplos de 0.5, > 0 y <= 7.
    function diaValido(d) {
      return d.keys().hasOnly(['usuarioId', 'dias', 'fecha'])
        && d.usuarioId is string
        && d.dias is number && d.dias > 0 && d.dias <= 7
        && math.floor(d.dias * 2) == d.dias * 2
        && d.fecha is timestamp;
    }

    // La línea {l} y su movimiento de consumo comparten id y cada uno exige al otro.
    // Lado de la línea: el movimiento se crea en este mismo lote (no se reutiliza
    // el de una línea borrada) y coincide en material, rollo, cantidad y destino.
    function consumoEnlazado(p, m, l) {
      let d = request.resource.data;
      let ruta = /databases/$(database)/documents/movimientos/$(l);
      let mov = getAfter(ruta).data;
      return !exists(ruta)
        && mov.tipo == 'consumo'
        && mov.materialId == d.materialId
        && mov.get('rolloId', null) == d.rolloId
        && mov.cantidad == -d.cantidad
        && mov.pedidoId == p
        && mov.muebleId == m;
    }

    // Lado del movimiento: existe (tras el lote) una línea con el mismo id, no del
    // cliente, en el pedido/mueble que indica, y con los mismos datos.
    function consumoDeLinea(id, d) {
      let linea = getAfter(/databases/$(database)/documents/pedidos/$(d.pedidoId)/muebles/$(d.muebleId)/materiales/$(id)).data;
      return movimientoValido(d)
        && d.tipo == 'consumo'
        && d.cantidad < 0
        && d.pedidoId is string
        && d.muebleId is string
        && linea.delCliente == false
        && linea.materialId == d.materialId
        && linea.rolloId == d.get('rolloId', null)
        && linea.cantidad == -d.cantidad;
    }

    // Solo para update: la existencia baja (consumo del empleado) y sigue acotada.
    // No se puede ligar el monto a un movimiento; se acepta (ver plan 3, tarea 4).
    function soloBajaExistencia() {
      return soloCambia(['existencia'])
        && request.resource.data.existencia is number
        && request.resource.data.existencia > -1000000000000000
        && request.resource.data.existencia < resource.data.existencia;
    }

    match /materiales/{id} {
      allow read: if activo();
      allow create: if esDueno() && materialValido(request.resource.data);
      allow update: if (esDueno() && materialValido(request.resource.data))
        || (esEmpleado() && soloCambia(['marcadoAgotandose'])
          && request.resource.data.marcadoAgotandose == true)
        || (esEmpleado() && soloBajaExistencia());
      allow delete: if esDueno();
    }

    match /materiales_costos/{id} {
      allow read, write: if esDueno();
    }

    match /rollos/{id} {
      allow read: if activo();
      allow create: if esDueno() && rolloValido(request.resource.data);
      allow update: if (esDueno() && rolloValido(request.resource.data))
        || (esEmpleado() && soloBajaExistencia());
      allow delete: if esDueno();
    }

    match /rollos_costos/{id} {
      allow read, write: if esDueno();
    }

    match /compras/{id} {
      allow read, write: if esDueno();
    }

    // Inmutables: las correcciones se hacen con un ajuste (nuevo movimiento).
    match /movimientos/{id} {
      allow read: if activo();
      allow create: if (esDueno() && movimientoValido(request.resource.data))
        || (activo() && consumoDeLinea(id, request.resource.data));
      allow update, delete: if false;
    }

    // ---- Clientes, pedidos, muebles, precios y plantillas ----
    // Acotado: rechaza negativos, NaN (NaN >= 0 es false) e Infinity.
    function dinero(v) {
      return v is number && v >= 0 && v < 1000000000;
    }

    function textoHasta(v, max) {
      return v is string && v.size() <= max;
    }

    function textoEntre(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function estadoValido(e) {
      return e in ['recibido', 'en_proceso', 'terminado', 'entregado', 'cancelado'];
    }

    function nuloOTexto(v) {
      return v == null || v is string;
    }

    function nuloOFecha(v) {
      return v == null || v is timestamp;
    }

    function clienteValido(d) {
      return d.keys().hasOnly(['nombre', 'telefono', 'direccion'])
        && textoEntre(d.nombre, 1, 100)
        && textoHasta(d.telefono, 30)
        && textoHasta(d.direccion, 200);
    }

    function pedidoValido(d) {
      return d.keys().hasOnly(['folio', 'clienteId', 'cliente', 'entrega', 'envio', 'comentarios',
          'fechaIngreso', 'fechaEstimada', 'fechaTerminado', 'fechaEntregado', 'estado', 'creadoPor',
          'ultimoCambioId'])
        && textoEntre(d.folio, 1, 20)
        && d.clienteId is string
        && clienteValido(d.cliente)
        && d.entrega in ['recoge', 'domicilio']
        && dinero(d.envio)
        && textoHasta(d.comentarios, 1000)
        && d.fechaIngreso is timestamp
        && d.fechaEstimada is timestamp
        && nuloOFecha(d.fechaTerminado)
        && nuloOFecha(d.fechaEntregado)
        && estadoValido(d.estado)
        && d.creadoPor is string
        && nuloOTexto(d.ultimoCambioId);
    }

    function muebleValido(d) {
      return d.keys().hasOnly(['tipoTrabajo', 'tipoMueble', 'plantillaId', 'precio', 'comentarios',
          'estado', 'ultimoCambioId'])
        && d.tipoTrabajo in ['fabricacion', 'reparacion']
        && textoEntre(d.tipoMueble, 1, 100)
        && nuloOTexto(d.plantillaId)
        && dinero(d.precio)
        && textoHasta(d.comentarios, 1000)
        && estadoValido(d.estado)
        && nuloOTexto(d.ultimoCambioId);
    }

    function cambioValido(d) {
      return d.keys().hasOnly(['campo', 'muebleId', 'anterior', 'nuevo', 'motivo', 'usuarioId', 'fecha'])
        && ((d.campo in ['precio', 'alta', 'cancelacion'] && d.muebleId is string)
          || (d.campo == 'envio' && d.muebleId == null))
        && dinero(d.anterior)
        && dinero(d.nuevo)
        // Alta: de 0 al precio. Cancelación: del precio a 0 (ambas pueden ser 0 → 0).
        && (d.campo != 'alta' || d.anterior == 0)
        && (d.campo != 'cancelacion' || d.nuevo == 0)
        && (d.anterior != d.nuevo || d.campo in ['alta', 'cancelacion'])
        && (d.motivo == null || textoHasta(d.motivo, 200))
        && d.usuarioId == request.auth.uid
        && d.fecha == request.time;
    }

    function plantillaValida(d) {
      return d.keys().hasOnly(['tipoMueble', 'lineas'])
        && textoEntre(d.tipoMueble, 1, 100)
        && d.lineas is list && d.lineas.size() <= 50;
    }

    // Registro de cambio de precio que acompaña a la escritura (en el mismo lote).
    // Si el nuevo ultimoCambioId es null, la ruta falla y se deniega.
    function registroDe(p) {
      return getAfter(/databases/$(database)/documents/pedidos/$(p)/cambios_precio/$(request.resource.data.ultimoCambioId)).data;
    }

    function cambioRegistrado(p, campo) {
      return request.resource.data.ultimoCambioId != resource.data.get('ultimoCambioId', null)
        // El registro debe crearse en este mismo lote (no se reutiliza uno viejo).
        && !exists(/databases/$(database)/documents/pedidos/$(p)/cambios_precio/$(request.resource.data.ultimoCambioId))
        && registroDe(p).campo == campo
        && registroDe(p).anterior == resource.data[campo]
        && registroDe(p).nuevo == request.resource.data[campo]
        && registroDe(p).usuarioId == request.auth.uid;
    }

    // Aplica también al dueño: ningún cambio de precio pasa sin quedar registrado.
    function envioRegistrado(p) {
      return request.resource.data.envio == resource.data.envio
        || cambioRegistrado(p, 'envio');
    }

    function precioRegistrado(p, m) {
      return request.resource.data.precio == resource.data.precio
        || (cambioRegistrado(p, 'precio') && registroDe(p).muebleId == m);
    }

    // El registro se crea en este mismo lote (no se reutiliza uno viejo).
    function registroNuevo(p) {
      return !exists(/databases/$(database)/documents/pedidos/$(p)/cambios_precio/$(request.resource.data.ultimoCambioId));
    }

    // Mueble agregado a un pedido que ya existía: su registro 'alta' (0 → precio).
    function altaRegistrada(p, m) {
      return registroNuevo(p) && registroDe(p).campo == 'alta' && registroDe(p).muebleId == m
        && registroDe(p).nuevo == request.resource.data.precio
        && registroDe(p).usuarioId == request.auth.uid;
    }

    // Mueble cancelado: su registro 'cancelacion' (precio → 0).
    function cancelacionRegistrada(p, m) {
      return request.resource.data.ultimoCambioId != resource.data.get('ultimoCambioId', null)
        && registroNuevo(p) && registroDe(p).campo == 'cancelacion' && registroDe(p).muebleId == m
        && registroDe(p).anterior == resource.data.precio
        && registroDe(p).usuarioId == request.auth.uid;
    }

    // Cancelar exige registro; un mueble cancelado ya no cambia de estado.
    function estadoRegistrado(p, m) {
      let antes = resource.data.estado;
      let despues = request.resource.data.estado;
      return despues == antes
        || (antes != 'cancelado' && despues != 'cancelado')
        || (antes != 'cancelado' && despues == 'cancelado' && cancelacionRegistrada(p, m));
    }

    function cambioReal(ruta, campo, c) {
      return getAfter(ruta).data.ultimoCambioId == c
        && get(ruta).data[campo] == request.resource.data.anterior
        && getAfter(ruta).data[campo] == request.resource.data.nuevo;
    }

    match /clientes/{id} {
      allow read: if activo();
      allow create, update: if activo() && clienteValido(request.resource.data);
      allow delete: if esDueno();
    }

    match /pedidos/{p} {
      allow read: if activo();
      allow create: if activo()
        && pedidoValido(request.resource.data)
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.ultimoCambioId == null
        && request.resource.data.fechaTerminado == null
        && request.resource.data.fechaEntregado == null;
      allow update: if pedidoValido(request.resource.data)
        && envioRegistrado(p)
        && (esDueno()
          || (esEmpleado() && soloCambia(['entrega', 'envio', 'comentarios', 'fechaEstimada',
              'fechaTerminado', 'fechaEntregado', 'estado', 'ultimoCambioId'])));
      allow delete: if esDueno();

      match /muebles/{m} {
        allow read: if activo();
        allow create: if activo()
          && muebleValido(request.resource.data)
          && request.resource.data.estado == 'recibido'
          && existsAfter(/databases/$(database)/documents/pedidos/$(p))
          // exists() mira el estado antes del lote: un mueble creado junto con su
          // pedido no lleva registro; uno agregado después, sí (alta).
          && ((!exists(/databases/$(database)/documents/pedidos/$(p))
              && request.resource.data.ultimoCambioId == null)
            || (exists(/databases/$(database)/documents/pedidos/$(p)) && altaRegistrada(p, m)));
        allow update: if muebleValido(request.resource.data)
          && precioRegistrado(p, m)
          && estadoRegistrado(p, m)
          && (esDueno()
            || (esEmpleado() && soloCambia(['precio', 'comentarios', 'estado', 'ultimoCambioId'])));
        // Solo se borra lo cancelado (la cancelación ya quedó en el historial).
        allow delete: if esDueno() && resource.data.estado == 'cancelado';

        // Material usado. Inmutable; el dueño la borra junto con un ajuste.
        match /materiales/{l} {
          allow read: if activo();
          allow create: if activo()
            && lineaValida(request.resource.data)
            && existsAfter(/databases/$(database)/documents/pedidos/$(p)/muebles/$(m))
            && (request.resource.data.delCliente == true || consumoEnlazado(p, m, l));
          allow update: if false;
          allow delete: if esDueno();
        }

        // Días trabajados. El empleado solo registra los suyos; el dueño, los de cualquiera.
        match /dias/{d} {
          allow read: if activo();
          allow create: if activo()
            && diaValido(request.resource.data)
            && existsAfter(/databases/$(database)/documents/pedidos/$(p)/muebles/$(m))
            && (request.resource.data.usuarioId == request.auth.uid || esDueno());
          allow update: if false;
          allow delete: if esDueno();
        }
      }

      // Historial de precios: solo el dueño lo lee; inmutable.
      match /cambios_precio/{c} {
        allow read: if esDueno();
        // El registro debe corresponder a un cambio real en el documento afectado
        // (antes == anterior, después == nuevo) que lo apunta con ultimoCambioId.
        allow create: if activo()
          && cambioValido(request.resource.data)
          && ((request.resource.data.campo == 'envio'
              && cambioReal(/databases/$(database)/documents/pedidos/$(p), 'envio', c))
            || (request.resource.data.campo == 'precio'
              && cambioReal(/databases/$(database)/documents/pedidos/$(p)/muebles/$(request.resource.data.muebleId), 'precio', c))
            // Alta: el mueble se crea en este lote, apuntando al registro, con ese precio.
            || (request.resource.data.campo == 'alta'
              && !exists(/databases/$(database)/documents/pedidos/$(p)/muebles/$(request.resource.data.muebleId))
              && getAfter(/databases/$(database)/documents/pedidos/$(p)/muebles/$(request.resource.data.muebleId)).data.ultimoCambioId == c
              && getAfter(/databases/$(database)/documents/pedidos/$(p)/muebles/$(request.resource.data.muebleId)).data.precio == request.resource.data.nuevo)
            // Cancelación: el mueble pasa a cancelado en este lote, desde su precio.
            || (request.resource.data.campo == 'cancelacion'
              && get(/databases/$(database)/documents/pedidos/$(p)/muebles/$(request.resource.data.muebleId)).data.estado != 'cancelado'
              && getAfter(/databases/$(database)/documents/pedidos/$(p)/muebles/$(request.resource.data.muebleId)).data.estado == 'cancelado'
              && get(/databases/$(database)/documents/pedidos/$(p)/muebles/$(request.resource.data.muebleId)).data.precio == request.resource.data.anterior
              && getAfter(/databases/$(database)/documents/pedidos/$(p)/muebles/$(request.resource.data.muebleId)).data.ultimoCambioId == c));
        allow update, delete: if false;
      }
    }

    // Consulta de grupo (Fabricación / Reparación).
    match /{ruta=**}/muebles/{m} {
      allow read: if activo();
    }

    match /plantillas/{id} {
      allow read: if activo();
      allow create, update: if esDueno() && plantillaValida(request.resource.data);
      allow delete: if esDueno();
    }

    // Todo lo demas, denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
